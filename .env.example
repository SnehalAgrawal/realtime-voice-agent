# Copy to .env to change a setting. With no .env at all, everything runs locally:
# no accounts and no API keys (run `npm run models` once, and have Ollama running).

# PORT=8080
# HOST=127.0.0.1             # 0.0.0.0 makes the server reachable from your network
# MAX_SESSIONS=1             # conversations at once (local models are sized for one)
# SYSTEM_PROMPT=You are a friendly voice assistant ...
# GREETING=Hi! I'm a voice assistant running on this computer. What would you like to talk about?
#                            (empty: no greeting)

# --- LLM ---------------------------------------------------------------------
# ollama (default, local) or openai-compatible (any provider with an
# OpenAI-compatible chat completions endpoint: set the base URL, model, and key).
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=
# LLM_TEMPERATURE=
# LLM_SEED=
# LLM_MAX_TOKENS=512
# LLM_NUM_CTX=8192          # ollama only

# --- Speech-to-text ----------------------------------------------------------
# local (default: Moonshine via sherpa-onnx), openai-compatible, or google.
# STT_PROVIDER=local
# STT_MODEL=moonshine-base-en     # local: moonshine-base-en or moonshine-tiny-en
# STT_THREADS=2                   # local only
# STT_BASE_URL=                   # openai-compatible: default https://api.openai.com/v1
# STT_API_KEY=
# STT_LANGUAGE=                   # e.g. en (openai-compatible) or en-US (google)

# --- Text-to-speech ----------------------------------------------------------
# local (default: Kokoro via sherpa-onnx), openai-compatible, or azure.
# TTS_PROVIDER=local
# TTS_MODEL=kokoro-en             # local: kokoro-en (float32) or kokoro-en-int8
# TTS_VOICE=af_heart              # local: a Kokoro voice; azure: e.g. en-US-JennyNeural
# TTS_SPEED=1
# TTS_THREADS=4                   # local only
# TTS_BASE_URL=
# TTS_API_KEY=
# TTS_REGION=                     # azure only, e.g. eastus

# Example, hosted speech with OpenAI:
# STT_PROVIDER=openai-compatible
# STT_API_KEY=your-key
# TTS_PROVIDER=openai-compatible
# TTS_API_KEY=your-key

# --- Turn taking -------------------------------------------------------------
# VAD_SILENCE_MS=500         # silence before the caller's turn counts as finished
# VAD_THRESHOLD=0.5
# VAD_MIN_SPEECH_MS=250
# VAD_PREROLL_MS=300         # audio kept from before the detected start of speech
# BARGE_IN=true              # caller speech stops the assistant

# --- Phone calls (Plivo Audio Streams) -----------------------------------------
# Answer URL: https://<public host>/plivo/answer ; the stream connects to /plivo.
# PLIVO_CONTENT_TYPE=audio/x-mulaw;rate=8000   # or audio/x-l16;rate=8000, audio/x-l16;rate=16000
# PLIVO_STREAM_URL=                             # default: wss://<Host of the answer request>/plivo
# PLIVO_STREAM_TOKEN=                           # if set, streams without ?token=<this> are refused

# --- Reply pipeline ----------------------------------------------------------
# CHUNKING=sentence          # sentence, clause, or whole
# TTS_CONCURRENCY=1
