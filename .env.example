# Copy to .env to change a setting. With no .env at all, everything runs locally:
# no accounts and no API keys.

# PORT=8080
# SYSTEM_PROMPT=You are a friendly voice assistant ...

# --- LLM ---------------------------------------------------------------------
# ollama (default, local) or openai-compatible (any provider with an
# OpenAI-compatible chat completions endpoint: set the base URL, model, and key).
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=
# LLM_TEMPERATURE=
# LLM_SEED=
# LLM_MAX_TOKENS=512
# LLM_NUM_CTX=8192          # ollama only

# Example, a hosted model:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-key

# --- Speech-to-text and text-to-speech ---------------------------------------
# Providers are added in the next steps: local (default), openai-compatible,
# google (speech-to-text), azure (text-to-speech).
# STT_PROVIDER=local
# TTS_PROVIDER=local

# --- Reply pipeline ----------------------------------------------------------
# CHUNKING=sentence          # sentence, clause, or whole
# TTS_CONCURRENCY=1
